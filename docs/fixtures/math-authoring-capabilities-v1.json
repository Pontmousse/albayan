    "latex": "Prefer the equation body without outer math delimiters.",
    "display": "Use the compact math token display boolean to select inline/display math.",
    "wrappers_accepted_by_albayan": [
      "$...$",
      "\\(...\\)",
      "$$...$$",
      "\\[...\\]"
    ]
  },
