{
  "contract_version": 1,
  "canonical_input": true,
  "representation": "canonical_english_latex",
  "instruction": "Before authoring new equations, use only round_trip_safe syntax below. Send ordinary canonical LaTeX through the compact Document2 math token. Never emit Burhan/BuTeX Arabic-side or output-only macros. Any command not advertised in round_trip_safe is outside the AI authoring contract, even if Burhan's permissive parser happens to tokenize it.",
