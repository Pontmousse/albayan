# عنوان FastAPI — المصدر الوحيد للحقيقة (thin adapter)
ALBAYAN_API_URL=http://localhost:8000

# مفتاح وكيل شخصي (stdio / Cursor المحلي). لا تضع مفتاحًا حقيقيًا هنا.
# أنشئه من /al-idayat/wukala عند DEV_MODE=true
ALBAYAN_AGENT_TOKEN=alb_xxxxxxxx

# النقل: stdio (محلي) أو streamable-http (Railway / عملاء بعيدة)
MCP_TRANSPORT=stdio

# Streamable HTTP — يحقن Railway المتغير PORT تلقائيًا
HOST=0.0.0.0
PORT=8080

# OAuth عبر Clerk (اختياري — للعملاء البعيدة مثل ChatGPT و Claude)
# يُفعَّل فقط إذا ضُبط الاثنان معًا
# CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
# MCP_RESOURCE_URL=https://mcp.albayan-journal.org/mcp
