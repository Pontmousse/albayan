# Developer services. Leave unset when a service is not available; dev.health
# will report the exact missing configuration instead of failing startup.
ALBAYAN_DEV_URL=http://localhost:8000
BURHAN_DEV_URL=
BUTEX_DEV_URL=

# Optional bearer tokens used only when calling the matching configured service.
# Phase 3/4 equation diagnostics require ALBAYAN_DEV_TOKEN because the backend
# diagnostic endpoint is authenticated and available only with DEV_MODE=true.
ALBAYAN_DEV_TOKEN=
BURHAN_DEV_TOKEN=
BUTEX_DEV_TOKEN=

# Remote streamable-HTTP authentication. Required for remote HTTP mode.
# The authenticated Clerk user must have public_metadata.developer exactly true.
# This is independent from other metadata such as role="admin".
# CLERK_SECRET_KEY is server-only; never expose it to ChatGPT or another MCP client.
CLERK_ISSUER_URL=
CLERK_SECRET_KEY=
DEV_MCP_RESOURCE_URL=

# MCP transport settings.
DEV_MCP_HOST=127.0.0.1
DEV_MCP_PORT=8083
MCP_TRANSPORT=stdio

# Safety bounds.
DEV_MCP_REQUEST_TIMEOUT_SECONDS=10
# Separate bound for equation diagnostics because cheap/medium Burhan tiers can
# take longer than generic GET diagnostics. Maximum accepted value is 180 sec.
DEV_MCP_EQUATION_TIMEOUT_SECONDS=90
DEV_MCP_MAX_RESPONSE_BYTES=262144

# Phase-2 local trace source bounds. This is process-local and non-persistent;
# a centralized development adapter can replace it later without changing tools.
DEV_MCP_TRACE_MAX_TRACES=200
DEV_MCP_TRACE_MAX_EVENTS_PER_TRACE=50

# Phase-4 investigation/reporting bounds.
DEV_MCP_REPORT_MAX_ROWS=50
# This is only a capability hint for an external Playwright MCP. The Dev MCP
# never launches/proxies Playwright itself.
DEV_MCP_BROWSER_OBSERVATION_AVAILABLE=false
