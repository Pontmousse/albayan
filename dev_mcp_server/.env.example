# Developer services. Leave unset when a service is not available; dev.health
# will report the exact missing configuration instead of failing startup.
ALBAYAN_DEV_URL=http://localhost:8000
BURHAN_DEV_URL=
BUTEX_DEV_URL=

# Optional bearer tokens used only when calling the matching configured service.
ALBAYAN_DEV_TOKEN=
BURHAN_DEV_TOKEN=
BUTEX_DEV_TOKEN=

# MCP transport settings.
DEV_MCP_HOST=127.0.0.1
DEV_MCP_PORT=8083
MCP_TRANSPORT=stdio

# Safety bounds.
DEV_MCP_REQUEST_TIMEOUT_SECONDS=10
DEV_MCP_MAX_RESPONSE_BYTES=262144
