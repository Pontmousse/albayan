# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Custom auth routes (headless — no prebuilt Clerk components)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/tawajjuh
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/tasjil
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# OAuth consent UI lives at /oauth-consent (custom page). Point Clerk Dashboard
# → Configure → Paths → OAuth consent to that path (prod: full https URL on
# your application domain). No Clerk env var exists yet for consent routing.

# Public URL of the FastAPI backend (development default: port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key for the Arabic Payment Element on /daam-al-bayan.
# This key is intentionally public; never expose the Stripe secret/webhook key here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# عنوان خادم MCP (Streamable HTTP) — للعملاء البعيدة مثل ChatGPT و Claude
NEXT_PUBLIC_MCP_SERVER_URL=https://mcp.albayan-journal.org/mcp

# خادما التشخيص والمتصفح — تُعرض بطاقاتهما فقط عند تفعيل وضع التطوير.
NEXT_PUBLIC_DEV_MCP_SERVER_URL=https://devmcp.dev.albayan-journal.org/mcp
NEXT_PUBLIC_PLAYWRIGHT_MCP_SERVER_URL=https://playwright.dev.albayan-journal.org/mcp

# تطوير فقط — يعرض تشخيصات المحرر ومفاتيح الوكلاء والربط المحلي المتقدم.
# لا تفعّل في الإنتاج.
NEXT_PUBLIC_DEV_MODE=false

# وكلاء MCP — زر «وكلاء» وصفحة /wukala والربط البعيد (true/1/yes).
NEXT_PUBLIC_MCP_ENABLED=false
