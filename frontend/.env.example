# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Custom auth routes (headless — no prebuilt Clerk components)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/tawajjuh
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/tasjil
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# OAuth consent UI lives at /oauth-consent (custom page). Point Clerk Dashboard
# → Configure → Paths → OAuth consent to that path (prod: full https URL on
# your application domain). No Clerk env var exists yet for consent routing.

# Public URL of the FastAPI backend (development default: port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# عنوان خادم MCP (Streamable HTTP) — للعملاء البعيدة مثل ChatGPT و Claude
NEXT_PUBLIC_MCP_SERVER_URL=https://albayan-mcp-production.up.railway.app/mcp

# تطوير فقط — يعرض TeX المُصدَّر بجانب المعاينة (true/1/yes). لا تفعّل في الإنتاج.
NEXT_PUBLIC_DEV_MODE=false

# وكلاء MCP — زر «وكلاء» وصفحات /wukala وإدارة المفاتيح (true/1/yes).
NEXT_PUBLIC_MCP_ENABLED=false
