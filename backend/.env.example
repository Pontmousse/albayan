# PostgreSQL — يطابق docker-compose في backend/database/ (منفذ المضيف 5434)
DATABASE_URL=postgresql://albayan_user:albayan_password@localhost:5434/albayan

# Clerk — مفتاح سري من https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...

# وضع التطوير — يفعّل أدوات التشخيص (مثل compile.log). لا تفعّله في الإنتاج.
DEV_MODE=false

# وكلاء MCP — مفاتيح الوكيل ومصادقة alb_ ومسارات الواجهة /wukala.
MCP_ENABLED=false

# عنوان مورد MCP العام — نفس MCP_RESOURCE_URL في خدمة mcp_server.
# مطلوب لقبول توكنات OAuth من وكلاء مثل ChatGPT (التحقق عبر aud).
# MCP_RESOURCE_URL=https://albayan-mcp-production.up.railway.app/mcp

# إعداد التطبيق لروابط البريد وإعادة التوجيه.
# استخدم https://albayan-journal.org في الإنتاج.
FRONTEND_BASE_URL=http://localhost:3000

# CORS — قائمة مفصولة بفواصل
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://albayan-journal.org

# مترجم المعاينة المشترك (اختياري — بدونها تُعطَّل مسارات التجميع)
# COMPILER_URL=http://localhost:8082

# عامل BuTeX الخاص لتحويلات المستند وجلسات التحرير المشتركة.
# في Railway: BUTEX_WORKER_URL=http://${{albayan-butex.RAILWAY_PRIVATE_DOMAIN}}:${{albayan-butex.PORT}}
# BUTEX_WORKER_URL=http://localhost:8083
# BUTEX_WORKER_TOKEN=

# تخزين الوثائق (اختياري — بدونها ترجع مسارات المستند 503)
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# البريد عبر Resend (اختياري، لكن يجب ضبط المجموعة كاملة عند تفعيله)
# المفتاح خادمي فقط؛ لا تستخدم له بادئة NEXT_PUBLIC_ ولا تسجله في السجلات.
# RESEND_API_KEY=re_xxxxxxxxxx
# EMAIL_FROM="مجلة البيان <mail@albayan-journal.org>"
# EMAIL_REPLY_TO="مجلة البيان <support@albayan-journal.org>"
# RESEND_WELCOME_TEMPLATE=welcome-ar
# RESEND_APP_INVITATION_TEMPLATE=app-invitation-ar
# RESEND_AUTH_VERIFICATION_TEMPLATE=auth-verification-code-ar
# RESEND_PASSWORD_RESET_TEMPLATE=password-reset-ar
# EMAIL_ASSET_BASE_URL=https://albayan-journal.org/email

# Clerk webhooks — from the Clerk Dashboard webhook endpoint.
# Required when Clerk email templates are configured with Delivered by Clerk=false.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
