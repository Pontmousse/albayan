# PostgreSQL — يطابق docker-compose في backend/database/ (منفذ المضيف 5434)
DATABASE_URL=postgresql://albayan_user:albayan_password@localhost:5434/albayan

# Clerk — مفتاح سري من https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...

# وضع التطوير — يفعّل أدوات التشخيص (مثل compile.log). لا تفعّله في الإنتاج.
DEV_MODE=false

# وكلاء MCP — مفاتيح الوكيل ومصادقة alb_ ومسارات الواجهة /wukala.
MCP_ENABLED=false

# إعداد التطبيق لروابط البريد وإعادة التوجيه.
# استخدم https://albayan-journal.org في الإنتاج.
FRONTEND_BASE_URL=http://localhost:3000

# CORS — قائمة مفصولة بفواصل
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://albayan-journal.org

# Stripe — مساهمات اختيارية عبر Checkout Sessions + Payment Element.
# اضبط المفتاح السري ومفتاح webhook معاً، ولا تعرضهما في NEXT_PUBLIC_*.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
# DONATION_CURRENCY=cad
# DONATION_MIN_AMOUNT_MINOR=500
# DONATION_MAX_AMOUNT_MINOR=500000
# DONATION_MINOR_UNIT_DIVISOR=100

# مترجم المعاينة المشترك (اختياري — بدونها تُعطَّل مسارات التجميع)
# COMPILER_URL=http://localhost:8082

# عامل BuTeX الخاص لتحويلات المستند وجلسات التحرير المشتركة.
# في Railway: BUTEX_WORKER_URL=http://${{albayan-butex.RAILWAY_PRIVATE_DOMAIN}}:${{albayan-butex.PORT}}
# BUTEX_WORKER_URL=http://localhost:8083
# BUTEX_WORKER_TOKEN=

# Burhan — تحويل LaTeX الإنجليزي إلى الصيغة الرياضية العربية المنظمة.
# في Railway استخدم عنوان الخدمة الداخلي لـ albayan-burhan.
# BURHAN_URL=http://localhost:8010
# BURHAN_MODEL_TIER=cheap

# OpenRouter — تلخيص فروق مراجعات المسودة (اختياري؛ المفتاح خادمي فقط).
# عند غياب المفتاح ترجع واجهة change-summary بقيمة summary=null دون تعطيل سجل المراجعات.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free

# تخزين الوثائق (اختياري — بدونها ترجع مسارات المستند 503)
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# البريد عبر Resend (اختياري، لكن يجب ضبط المجموعة كاملة عند تفعيله)
# المفتاح خادمي فقط؛ لا تستخدم له بادئة NEXT_PUBLIC_ ولا تسجله في السجلات.
# RESEND_API_KEY=re_xxxxxxxxxx
# EMAIL_FROM="مجلة البيان <mail@albayan-journal.org>"
# EMAIL_REPLY_TO="مجلة البيان <support@albayan-journal.org>"
# RESEND_WELCOME_TEMPLATE=welcome-ar
# RESEND_APP_INVITATION_TEMPLATE=app-invitation-ar
# RESEND_AUTH_VERIFICATION_TEMPLATE=auth-verification-code-ar
# RESEND_PASSWORD_RESET_TEMPLATE=password-reset-ar
# RESEND_SUBMISSION_RECEIVED_TEMPLATE=submission-received-ar
# RESEND_NEW_SUBMISSION_ALERT_TEMPLATE=new-submission-alert-ar
# RESEND_EDITOR_ASSIGNED_TEMPLATE=editor-assigned-ar
# RESEND_REVIEW_INVITATION_TEMPLATE=review-invitation-ar
# RESEND_REVIEWER_ASSIGNED_TEMPLATE=reviewer-assigned-ar
# RESEND_REVIEW_REMINDER_TEMPLATE=review-reminder-ar
# RESEND_REVIEW_SUBMITTED_TEMPLATE=review-submitted-ar
# RESEND_DECISION_TEMPLATE=decision-ar
# RESEND_ARTICLE_PUBLISHED_TEMPLATE=article-published-ar
# RESEND_UNREAD_NOTIFICATIONS_DIGEST_TEMPLATE=unread-notifications-digest-ar
# اختياري: إن لم يضبط، يُستخدم HTML عربي آمن كبديل لتأكيد المساهمة.
# RESEND_DONATION_RECEIVED_TEMPLATE=donation-received-ar

# Clerk webhooks — from the Clerk Dashboard webhook endpoint.
# Required when Clerk email templates are configured with Delivered by Clerk=false.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
